{
  "name": "async-ai-job-queue",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-cost async AI job queue on Cloudflare Workers: durable job state machine, Queues + DLQ, SSRF-safe fetching, content-hash caching, and free OpenRouter summarization.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:check": "wrangler deploy --dry-run --outdir dist",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.9.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.40.0"
  }
}
